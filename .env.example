# Mapbox Access Token
# Get your token from https://account.mapbox.com/access-tokens/
# Copy this file to .env and replace the placeholder with your actual token
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Supabase (for app and seed script)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# One-time seed and Storage upload: use service_role key so inserts bypass RLS. Do not commit.
# Get from Supabase: Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Project data: when VITE_SUPABASE_URL is set, the app loads projects from Storage instead of the static GeoJSON.
# Create a public Storage bucket named "project-data" in Supabase Dashboard. Then run:
#   npm run seed          # populate projects table
#   npm run upload-geojson # write projects.geojson to Storage (one-time or after data changes)
# Alternatively deploy the Edge Function "regenerate-projects-geojson" and invoke it after uploads/edits.
