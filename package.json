{
  "name": "miami-climate-dashboard",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "a11y": "vitest run src/a11y --reporter=verbose",
    "seed": "node --env-file=.env scripts/js/seed-supabase.js",
    "seed-merged": "node --env-file=.env scripts/js/seed-supabase-merged.js",
    "seed-merged-conf1": "node --env-file=.env scripts/js/seed-supabase-merged-conf1.js",
    "upload-geojson": "node --env-file=.env scripts/js/upload-projects-geojson.js",
    "upload-geojson-merged": "node --env-file=.env scripts/js/upload-projects-merged-geojson.js",
    "upload-geojson-merged-conf1": "node --env-file=.env scripts/js/upload-projects-merged-conf1-geojson.js",
    "add-tract-geoid": "python3 scripts/python/add_tract_geoid_conf1.py",
    "sync-tract-geoid": "node --env-file=.env scripts/js/sync-tract-geoid-to-supabase.js",
    "reproject-femaindex": "node tools/reproject-femaindex-to-4326.mjs",
    "compare-fema-ratings": "python3 compare_fema_ratings.py",
    "refresh-femaindex": "python3 refresh_femaindex_from_csv.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "firebase": "^12.9.0",
    "mapbox-gl": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.11.4",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^17.6.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^7.1.7",
    "vitest": "^1.0.4"
  }
}
